{
  "name": "football-scheduler-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && node scripts/check-preview-isolation.mjs",
    "build:functions": "wrangler pages functions build functions --outdir .wrangler-build",
    "dev": "vite",
    "lint": "tsc -b --pretty false",
    "preview": "vite preview",
    "preview:brackets": "node scripts/render-tournament-bracket-previews.mjs",
    "preview:print": "node scripts/render-print-preview-pdfs.mjs",
    "preview:excel": "node scripts/render-schedule-workbooks.mjs",
    "preview:league-results": "node scripts/render-schedule-workbooks.mjs --fixture-set league-results",
    "preview:results": "node scripts/render-tournament-results-previews.mjs",
    "check:preview-isolation": "node scripts/check-preview-isolation.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.14.0",
    "fake-indexeddb": "^6.0.1",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "read-excel-file": "^9.3.10",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "dependencies": {
    "write-excel-file": "^4.1.1"
  }
}
